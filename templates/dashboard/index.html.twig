{% extends 'base.html.twig' %}

{% block title %}Dashboard{% endblock %}

{% block body %}
<div>
    <h1 class="text-2xl font-bold text-gray-800 mb-6">Dashboard</h1>

    <div class="grid grid-cols-4 gap-4 mb-8">
        <div class="bg-white rounded-xl shadow-sm p-5">
            <div class="w-10 h-10 rounded-lg bg-green-100 flex items-center justify-center mb-3">
                <span class="text-green-600 font-bold">€</span>
            </div>
            <p class="text-sm text-gray-500">Chiffre d'affaires (Payé)</p>
            <p class="text-2xl font-bold text-gray-800 mt-1">{{ totalCa }} €</p>
        </div>
        <div class="bg-white rounded-xl shadow-sm p-5">
            <div class="w-10 h-10 rounded-lg bg-orange-100 flex items-center justify-center mb-3">
                <span class="text-orange-600 font-bold">📄</span>
            </div>
            <p class="text-sm text-gray-500">Factures en attente de paiement</p>
            <p class="text-2xl font-bold text-gray-800 mt-1">{{ pendingInvoices }}</p>
        </div>
        <div class="bg-white rounded-xl shadow-sm p-5">
            <div class="w-10 h-10 rounded-lg bg-blue-100 flex items-center justify-center mb-3">
                <span class="text-blue-600 font-bold">👥</span>
            </div>
            <p class="text-sm text-gray-500">Total Clients</p>
            <p class="text-2xl font-bold text-gray-800 mt-1">{{ totalClients }}</p>
        </div>
        <div class="bg-white rounded-xl shadow-sm p-5">
            <div class="w-10 h-10 rounded-lg bg-purple-100 flex items-center justify-center mb-3">
                <span class="text-purple-600 font-bold">📦</span>
            </div>
            <p class="text-sm text-gray-500">Total Produits</p>
            <p class="text-2xl font-bold text-gray-800 mt-1">{{ totalProducts }}</p>
        </div>
    </div>

    <div class="bg-white rounded-xl shadow-sm p-6 mb-8">
        <div class="flex items-center justify-between mb-4">
            <h2 class="text-base font-semibold text-gray-700">Chiffre d'affaires mensuel (Factures payées)</h2>
            <select onchange="window.location.href='{{ path('app_dashboard') }}?year=' + this.value" class="border border-gray-300 rounded-lg px-3 py-1 text-sm focus:outline-none focus:ring-2 focus:ring-blue-500">
                {% for y in years %}
                    <option value="{{ y }}" {% if y == year %}selected{% endif %}>{{ y }}</option>
                {% endfor %}
            </select>
        </div>
        {{ render_chart(chart, {'style': 'max-height: 250px'}) }}
    </div>

    <div class="grid grid-cols-3 gap-4 mb-4">
        <a href="{{ path('app_invoice_new') }}" class="bg-blue-50 border border-blue-200 rounded-xl p-5 flex items-center justify-between hover:bg-blue-100 transition">
            <div>
                <p class="text-blue-900 font-bold">Créer une facture</p>
                <p class="text-sm text-blue-500">Nouvelle prestation</p>
            </div>
            <span class="text-blue-600 text-xl">→</span>
        </a>
        <a href="{{ path('app_client_new') }}" class="bg-white rounded-xl p-5 flex items-center justify-between hover:bg-gray-50 transition shadow-sm">
            <div>
                <p class="font-semibold text-gray-800">Ajouter un client</p>
                <p class="text-sm text-gray-500">Gérer le répertoire</p>
            </div>
            <span class="text-gray-400 text-xl">→</span>
        </a>
        <a href="{{ path('app_product_new') }}" class="bg-white rounded-xl p-5 flex items-center justify-between hover:bg-gray-50 transition shadow-sm">
            <div>
                <p class="font-semibold text-gray-800">Créer un produit / service</p>
                <p class="text-sm text-gray-500">Enrichir le catalogue pour rédiger rapidement vos factures</p>
            </div>
            <span class="text-gray-400 text-xl">→</span>
        </a>
    </div>

    <div class="grid grid-cols-3 gap-4">
        <form method="post" action="{{ path('app_dashboard_remind_all') }}">
            <button type="submit" class="w-full bg-white rounded-xl p-5 flex items-center justify-between hover:bg-gray-50 transition shadow-sm text-left">
                <div>
                    <p class="font-semibold text-gray-800">Relancer tous les clients</p>
                    <p class="text-sm text-gray-500">Envoyer un mail à tous les clients en retard de paiement</p>
                </div>
                <span class="text-gray-400 text-xl">→</span>
            </button>
        </form>
    </div>
</div>
{% endblock %}
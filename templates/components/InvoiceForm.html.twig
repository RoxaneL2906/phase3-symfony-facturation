<div{{ attributes }}>
    <div class="bg-white rounded-xl shadow-sm p-6 mb-4">
        <h2 class="text-base font-semibold text-gray-700 mb-4">Informations Générales</h2>
        <div class="flex gap-4 mb-4">
            <div class="flex-1">
                <label class="block text-sm text-gray-600 mb-1">Client</label>
                <select data-model="selectedClientId" class="w-full border border-gray-300 rounded-lg px-3 py-2 text-sm focus:outline-none focus:ring-2 focus:ring-blue-500">
                    <option value="0">-- Sélectionner un client --</option>
                    {% for client in this.availableClients %}
                        <option value="{{ client.id }}" {% if selectedClientId == client.id %}selected{% endif %}>
                            {{ client.name }}
                        </option>
                    {% endfor %}
                </select>
                {% if error %}
                    <p class="text-red-500 text-sm mt-1">{{ error }}</p>
                {% endif %}
            </div>
            <div class="flex-1">
                <label class="block text-sm text-gray-600 mb-1">Date de la facture</label>
                <input type="date" data-model="invoiceDate" value="{{ invoiceDate }}" class="w-full border border-gray-300 rounded-lg px-3 py-2 text-sm focus:outline-none focus:ring-2 focus:ring-blue-500">
            </div>
        </div>
    </div>

    <div class="bg-white rounded-xl shadow-sm p-6 mb-4">
        <h2 class="text-base font-semibold text-gray-700 mb-4">Lignes de la facture</h2>

        <table class="w-full mb-4">
            <thead>
                <tr class="border-b border-gray-100">
                    <th class="text-left text-sm font-medium text-gray-500 py-2">Produit / Service</th>
                    <th class="text-center text-sm font-medium text-gray-500 py-2">Qté</th>
                    <th class="text-center text-sm font-medium text-gray-500 py-2">Prix Unitaire</th>
                    <th class="text-center text-sm font-medium text-gray-500 py-2">Total</th>
                    <th></th>
                </tr>
            </thead>
            <tbody>
                {% for index, line in lines %}
                <tr class="border-b border-gray-50">
                    <td class="py-3 text-sm text-gray-800">{{ line.name }}</td>
                    <td class="py-3 text-sm text-center text-gray-600">{{ line.quantity }}</td>
                    <td class="py-3 text-sm text-center text-gray-600">{{ line.unitPrice }} €</td>
                    <td class="py-3 text-sm text-center text-gray-800 font-medium">{{ line.total }} €</td>
                    <td class="py-3 text-center">
                        <button type="button" data-action="click->live#action" data-live-action-param="removeLine" data-live-index-param="{{ index }}" class="text-red-500 hover:text-red-700">
                            <svg xmlns="http://www.w3.org/2000/svg" class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 7l-.867 12.142A2 2 0 0116.138 21H7.862a2 2 0 01-1.995-1.858L5 7m5 4v6m4-6v6m1-10V4a1 1 0 00-1-1h-4a1 1 0 00-1 1v3M4 7h16"/></svg>
                        </button>
                    </td>
                </tr>
                {% else %}
                <tr>
                    <td colspan="5" class="py-4 text-center text-sm text-gray-400">Aucune ligne ajoutée</td>
                </tr>
                {% endfor %}
            </tbody>
        </table>

        <div class="border-t border-gray-100 pt-4">
            <div class="flex gap-3 items-end mb-3">
                <div class="flex-1">
                    <label class="block text-sm text-gray-600 mb-1">Sélectionner un produit du catalogue</label>
                    <select data-model="selectedProductId" class="w-full border border-gray-300 rounded-lg px-3 py-2 text-sm focus:outline-none focus:ring-2 focus:ring-blue-500">
                        <option value="0">-- Choisir un produit --</option>
                        {% for product in this.availableProducts %}
                            <option value="{{ product.id }}" data-price="{{ product.price }}">
                                {{ product.name }} - {{ product.price }} €/{{ product.unit }}
                            </option>
                        {% endfor %}
                    </select>
                </div>
                <div class="w-24">
                    <label class="block text-sm text-gray-600 mb-1">Quantité</label>
                    <input type="number" data-model="quantity" value="{{ quantity }}" min="1" class="w-full border border-gray-300 rounded-lg px-3 py-2 text-sm focus:outline-none focus:ring-2 focus:ring-blue-500">
                </div>
                <div class="w-32">
                    <label class="block text-sm text-gray-600 mb-1">Prix unitaire (€)</label>
                    <input type="number" data-model="unitPrice" value="{{ unitPrice }}" step="0.01" class="w-full border border-gray-300 rounded-lg px-3 py-2 text-sm focus:outline-none focus:ring-2 focus:ring-blue-500">
                </div>
                <button type="button" data-action="click->live#action" data-live-action-param="addLine" class="bg-gray-800 hover:bg-gray-900 text-white text-sm font-semibold px-4 py-2 rounded-lg transition">
                    + Ajouter
                </button>
            </div>

            <div class="flex items-center gap-3 mb-3">
                <div class="flex-1 border-t border-gray-200"></div>
                <span class="text-xs text-gray-400">ou saisir manuellement</span>
                <div class="flex-1 border-t border-gray-200"></div>
            </div>

            <div class="flex gap-3 items-end">
                <div class="flex-1">
                    <label class="block text-sm text-gray-600 mb-1">Nom du produit / service</label>
                    <input type="text" data-model="manualName" value="{{ manualName }}" placeholder="Ex: Développement web, Conseil..." class="w-full border border-gray-300 rounded-lg px-3 py-2 text-sm focus:outline-none focus:ring-2 focus:ring-blue-500">
                </div>
                <div class="w-24">
                    <label class="block text-sm text-gray-600 mb-1">Quantité</label>
                    <input type="number" data-model="manualQuantity" value="{{ manualQuantity }}" min="1" class="w-full border border-gray-300 rounded-lg px-3 py-2 text-sm focus:outline-none focus:ring-2 focus:ring-blue-500">
                </div>
                <div class="w-32">
                    <label class="block text-sm text-gray-600 mb-1">Prix unitaire (€)</label>
                    <input type="number" data-model="manualUnitPrice" value="{{ manualUnitPrice }}" step="0.01" class="w-full border border-gray-300 rounded-lg px-3 py-2 text-sm focus:outline-none focus:ring-2 focus:ring-blue-500">
                </div>
                <button type="button" data-action="click->live#action" data-live-action-param="addLine" class="bg-gray-800 hover:bg-gray-900 text-white text-sm font-semibold px-4 py-2 rounded-lg transition">
                    + Ajouter
                </button>
            </div>
        </div>

        <div class="flex justify-end mt-4">
            <div class="text-right">
                <span class="text-sm text-gray-600 font-semibold">Total Facture (TTC) : </span>
                <span class="text-blue-600 font-bold text-lg">{{ this.total|number_format(2) }} €</span>
            </div>
        </div>
    </div>

    <div class="flex gap-3 justify-end mt-4">
        <a href="{{ path('app_invoice_index') }}" class="px-4 py-2 text-sm text-gray-600 border border-gray-300 rounded-lg hover:bg-gray-50 transition">
            Annuler
        </a>
        <button type="button" data-action="click->live#action" data-live-action-param="save" data-live-action-value="draft" class="px-4 py-2 text-sm text-blue-600 border border-blue-300 rounded-lg hover:bg-blue-50 transition">
            Enregistrer en brouillon
        </button>
        <button type="button" data-action="click->live#action" data-live-action-param="save" data-live-action-value="validate" class="px-4 py-2 text-sm bg-blue-600 hover:bg-blue-700 text-white font-semibold rounded-lg transition">
            Enregistrer et valider
        </button>
    </div>
</div>
            <a href="#" class="flex items-center gap-3 px-3 py-2 rounded-lg text-sm font-medium {{ app.request.attributes.get('_route') starts with 'app_invoice' ? 'bg-blue-50 text-blue-600' : 'text-gray-600 hover:bg-gray-100' }}">

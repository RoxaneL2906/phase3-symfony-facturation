{% extends 'base.html.twig' %}

{% block title %}Modifier la facture {{ invoice.number }}{% endblock %}

{% block body %}
<div class="max-w-6xl mx-auto">
    <div class="flex items-center justify-between mb-6">
        <div>
            <a href="{{ path('app_invoice_index') }}" class="text-sm text-gray-500 hover:text-gray-700">← Retour aux factures</a>
            <h1 class="text-2xl font-bold text-gray-800 mt-1">Modifier la facture {{ invoice.number }}</h1>
        </div>
    </div>

    {{ form_start(form) }}

    <div class="bg-white rounded-xl shadow-sm p-6 mb-4">
        <h2 class="text-base font-semibold text-gray-700 mb-4">Informations Générales</h2>
        <div class="flex gap-4">
            <div class="flex-1">
                <label class="block text-sm text-gray-600 mb-1">Client</label>
                {{ form_widget(form.client, {'attr': {'class': 'w-full border border-gray-300 rounded-lg px-3 py-2 text-sm focus:outline-none focus:ring-2 focus:ring-blue-500'}}) }}
                {{ form_errors(form.client) }}
            </div>
            <div class="flex-1">
                <label class="block text-sm text-gray-600 mb-1">Date de la facture</label>
                {{ form_widget(form.createdAt, {'attr': {'class': 'w-full border border-gray-300 rounded-lg px-3 py-2 text-sm focus:outline-none focus:ring-2 focus:ring-blue-500'}}) }}
                {{ form_errors(form.createdAt) }}
            </div>
        </div>
    </div>

    <twig:InvoiceForm :invoice="invoice" />

    <div class="flex gap-3 justify-between mt-4">
        <div>
            {{ include('invoice/_delete_form.html.twig') }}
        </div>
        <div class="flex gap-3">
            <a href="{{ path('app_invoice_index') }}" class="px-4 py-2 text-sm text-gray-600 border border-gray-300 rounded-lg hover:bg-gray-50 transition">
                Annuler
            </a>
            <button type="submit" name="action" value="draft" class="px-4 py-2 text-sm text-blue-600 border border-blue-300 rounded-lg hover:bg-blue-50 transition">
                Enregistrer en brouillon
            </button>
            <button type="submit" name="action" value="validate" class="px-4 py-2 text-sm bg-blue-600 hover:bg-blue-700 text-white font-semibold rounded-lg transition">
                Enregistrer et valider
            </button>
        </div>
    </div>

    {{ form_end(form) }}
</div>
{% endblock %}
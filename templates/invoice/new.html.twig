{% extends 'base.html.twig' %}

{% block title %}Nouvelle facture{% endblock %}

{% block body %}
<div class="max-w-6xl mx-auto">
    <div class="flex items-center justify-between mb-6">
        <div>
            <a href="{{ path('app_invoice_index') }}" class="text-sm text-gray-500 hover:text-gray-700">← Retour aux factures</a>
            <h1 class="text-2xl font-bold text-gray-800 mt-1">Créer une facture</h1>
        </div>
    </div>

    {{ form_start(form) }}

    <div class="bg-white rounded-xl shadow-sm p-6 mb-4">
        <h2 class="text-base font-semibold text-gray-700 mb-4">Informations Générales</h2>
        <div class="flex gap-4">
            <div class="flex-1">
                <label class="block text-sm text-gray-600 mb-1">Client</label>
                {{ form_widget(form.client, {'attr': {'class': 'w-full border border-gray-300 rounded-lg px-3 py-2 text-sm focus:outline-none focus:ring-2 focus:ring-blue-500'}}) }}
                {{ form_errors(form.client) }}
            </div>
            <div class="flex-1">
                <label class="block text-sm text-gray-600 mb-1">Date de la facture</label>
                {{ form_widget(form.createdAt, {'attr': {'class': 'w-full border border-gray-300 rounded-lg px-3 py-2 text-sm focus:outline-none focus:ring-2 focus:ring-blue-500'}}) }}
                {{ form_errors(form.createdAt) }}
            </div>
        </div>
    </div>

    <div class="bg-white rounded-xl shadow-sm p-6 mb-4">
        <h2 class="text-base font-semibold text-gray-700 mb-4">Lignes de la facture</h2>

        <table class="w-full mb-4">
            <thead>
                <tr class="border-b border-gray-100">
                    <th class="text-left text-sm font-medium text-gray-500 py-2">Produit / Service</th>
                    <th class="text-center text-sm font-medium text-gray-500 py-2">Qté</th>
                    <th class="text-center text-sm font-medium text-gray-500 py-2">Prix Unitaire</th>
                    <th class="text-center text-sm font-medium text-gray-500 py-2">Total</th>
                    <th></th>
                </tr>
            </thead>
            <tbody id="invoice-lines">
            </tbody>
        </table>

        <div class="flex gap-3 items-end border-t border-gray-100 pt-4">
            <div class="flex-1">
                <label class="block text-sm text-gray-600 mb-1">Sélectionner un produit</label>
                <select id="product-select" class="w-full border border-gray-300 rounded-lg px-3 py-2 text-sm focus:outline-none focus:ring-2 focus:ring-blue-500">
                    <option value="">-- Choisir un produit --</option>
                    {% for product in userProducts %}
                        <option value="{{ product.id }}" data-name="{{ product.name }}" data-price="{{ product.price }}" data-unit="{{ product.unit }}">
                            {{ product.name }} - {{ product.price }} €/{{ product.unit }}
                        </option>
                    {% endfor %}
                </select>
            </div>
            <div class="w-24">
                <label class="block text-sm text-gray-600 mb-1">Quantité</label>
                <input type="number" id="product-qty" value="1" min="1" class="w-full border border-gray-300 rounded-lg px-3 py-2 text-sm focus:outline-none focus:ring-2 focus:ring-blue-500">
            </div>
            <div class="w-32">
                <label class="block text-sm text-gray-600 mb-1">Prix unitaire (€)</label>
                <input type="number" id="product-price" step="0.01" class="w-full border border-gray-300 rounded-lg px-3 py-2 text-sm focus:outline-none focus:ring-2 focus:ring-blue-500">
            </div>
            <button type="button" onclick="addLine()" class="bg-gray-800 hover:bg-gray-900 text-white text-sm font-semibold px-4 py-2 rounded-lg transition">
                + Ajouter
            </button>
        </div>

        <input type="hidden" name="invoice_lines" id="invoice-lines-data" value="[]">

        <div class="flex justify-end mt-4">
            <div class="text-right">
                <span class="text-sm text-gray-600 font-semibold">Total Facture (TTC) : </span>
                <span id="total-display" class="text-blue-600 font-bold text-lg">0.00 €</span>
            </div>
        </div>
    </div>

    <div class="flex gap-3 justify-end">
        <a href="{{ path('app_invoice_index') }}" class="px-4 py-2 text-sm text-gray-600 border border-gray-300 rounded-lg hover:bg-gray-50 transition">
            Annuler
        </a>
        <button type="submit" name="action" value="draft" class="px-4 py-2 text-sm text-blue-600 border border-blue-300 rounded-lg hover:bg-blue-50 transition">
            Enregistrer en brouillon
        </button>
        <button type="submit" name="action" value="validate" class="px-4 py-2 text-sm bg-blue-600 hover:bg-blue-700 text-white font-semibold rounded-lg transition">
            Enregistrer et valider
        </button>
    </div>

    {{ form_end(form) }}
</div>

<script>
let lines = [];

function addLine() {
    const select = document.getElementById('product-select');
    const qty = parseFloat(document.getElementById('product-qty').value);
    const price = parseFloat(document.getElementById('product-price').value);

    if (!select.value || !qty || !price) return;

    const option = select.options[select.selectedIndex];
    const line = {
        productId: select.value,
        name: option.dataset.name,
        qty: qty,
        price: price,
        total: qty * price
    };

    lines.push(line);
    renderLines();
    updateTotal();

    select.value = '';
    document.getElementById('product-qty').value = 1;
    document.getElementById('product-price').value = '';
}

function removeLine(index) {
    lines.splice(index, 1);
    renderLines();
    updateTotal();
}

function renderLines() {
    const tbody = document.getElementById('invoice-lines');
    tbody.innerHTML = '';
    lines.forEach((line, index) => {
        tbody.innerHTML += `
            <tr class="border-b border-gray-50">
                <td class="py-3 text-sm text-gray-800">${line.name}</td>
                <td class="py-3 text-sm text-center text-gray-600">${line.qty}</td>
                <td class="py-3 text-sm text-center text-gray-600">${line.price.toFixed(2)} €</td>
                <td class="py-3 text-sm text-center text-gray-800 font-medium">${line.total.toFixed(2)} €</td>
                <td class="py-3 text-center">
                    <button type="button" onclick="removeLine(${index})" class="text-red-500 hover:text-red-700">
                        <svg xmlns="http://www.w3.org/2000/svg" class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 7l-.867 12.142A2 2 0 0116.138 21H7.862a2 2 0 01-1.995-1.858L5 7m5 4v6m4-6v6m1-10V4a1 1 0 00-1-1h-4a1 1 0 00-1 1v3M4 7h16"/></svg>
                    </button>
                </td>
            </tr>
        `;
    });
    document.getElementById('invoice-lines-data').value = JSON.stringify(lines);
}

function updateTotal() {
    const total = lines.reduce((sum, line) => sum + line.total, 0);
    document.getElementById('total-display').textContent = total.toFixed(2) + ' €';
}

document.getElementById('product-select').addEventListener('change', function() {
    const option = this.options[this.selectedIndex];
    if (option.dataset.price) {
        document.getElementById('product-price').value = option.dataset.price;
    }
});
</script>
{% endblock %}
{% extends 'base.html.twig' %}

{% block title %}Factures{% endblock %}

{% block body %}
{% set activeFilters = {} %}
{% for key, value in filters %}
    {% if value is not empty %}
        {% set activeFilters = activeFilters|merge({(key): value}) %}
    {% endif %}
{% endfor %}

<div>
    <div class="flex items-center justify-between mb-6">
        <h1 class="text-2xl font-bold text-gray-800">Factures</h1>
        <a href="{{ path('app_invoice_new') }}" class="bg-blue-600 hover:bg-blue-700 text-white text-sm font-semibold px-4 py-2 rounded-lg flex items-center gap-2 transition">
            + Créer une facture
        </a>
    </div>

    <div class="bg-white rounded-xl shadow-sm mb-4 p-4">
        <form method="get" action="{{ path('app_invoice_index') }}" id="filterForm" class="flex flex-wrap gap-3 items-end">
            {% if currentStatus %}
                <input type="hidden" name="status" value="{{ currentStatus }}">
            {% endif %}

            <div>
                <label class="block text-xs text-gray-500 mb-1">Client</label>
                <select name="client" onchange="document.getElementById('filterForm').submit()" class="border border-gray-300 rounded-lg px-3 py-2 text-sm focus:outline-none focus:ring-2 focus:ring-blue-500">
                    <option value="">Tous les clients</option>
                    {% for client in clients %}
                        <option value="{{ client.id }}" {% if filters.client == (client.id ~ '') %}selected{% endif %}>
                            {{ client.name }}
                        </option>
                    {% endfor %}
                </select>
            </div>

            <div>
                <label class="block text-xs text-gray-500 mb-1">Mois</label>
                <select name="month" onchange="document.getElementById('filterForm').submit()" class="border border-gray-300 rounded-lg px-3 py-2 text-sm focus:outline-none focus:ring-2 focus:ring-blue-500">
                    <option value="">Tous les mois</option>
                    <option value="01" {% if filters.month == '01' %}selected{% endif %}>Janvier</option>
                    <option value="02" {% if filters.month == '02' %}selected{% endif %}>Février</option>
                    <option value="03" {% if filters.month == '03' %}selected{% endif %}>Mars</option>
                    <option value="04" {% if filters.month == '04' %}selected{% endif %}>Avril</option>
                    <option value="05" {% if filters.month == '05' %}selected{% endif %}>Mai</option>
                    <option value="06" {% if filters.month == '06' %}selected{% endif %}>Juin</option>
                    <option value="07" {% if filters.month == '07' %}selected{% endif %}>Juillet</option>
                    <option value="08" {% if filters.month == '08' %}selected{% endif %}>Août</option>
                    <option value="09" {% if filters.month == '09' %}selected{% endif %}>Septembre</option>
                    <option value="10" {% if filters.month == '10' %}selected{% endif %}>Octobre</option>
                    <option value="11" {% if filters.month == '11' %}selected{% endif %}>Novembre</option>
                    <option value="12" {% if filters.month == '12' %}selected{% endif %}>Décembre</option>
                </select>
            </div>

            <div>
                <label class="block text-xs text-gray-500 mb-1">Année</label>
                <select name="year" onchange="document.getElementById('filterForm').submit()" class="border border-gray-300 rounded-lg px-3 py-2 text-sm focus:outline-none focus:ring-2 focus:ring-blue-500">
                    <option value="">Toutes les années</option>
                    {% for year in range('now'|date('Y'), 'now'|date('Y') - 4) %}
                        <option value="{{ year }}" {% if filters.year == (year ~ '') %}selected{% endif %}>{{ year }}</option>
                    {% endfor %}
                </select>
            </div>

            <div>
                <label class="block text-xs text-gray-500 mb-1">Du</label>
                <input type="date" name="date_from" value="{{ filters.date_from }}" onchange="document.getElementById('filterForm').submit()" class="border border-gray-300 rounded-lg px-3 py-2 text-sm focus:outline-none focus:ring-2 focus:ring-blue-500">
            </div>

            <div>
                <label class="block text-xs text-gray-500 mb-1">Au</label>
                <input type="date" name="date_to" value="{{ filters.date_to }}" onchange="document.getElementById('filterForm').submit()" class="border border-gray-300 rounded-lg px-3 py-2 text-sm focus:outline-none focus:ring-2 focus:ring-blue-500">
            </div>

            <a href="{{ path('app_invoice_index', currentStatus ? {'status': currentStatus} : {}) }}" class="px-4 py-2 text-sm text-gray-600 border border-gray-300 rounded-lg hover:bg-gray-50 transition">
                Réinitialiser
            </a>
        </form>
    </div>

    <div class="bg-white rounded-xl shadow-sm">
        <div class="flex gap-2 p-4 border-b border-gray-100">
            <a href="{{ path('app_invoice_index', activeFilters) }}" class="px-4 py-1.5 rounded-full text-sm font-medium {{ currentStatus is null ? 'bg-blue-600 text-white' : 'text-gray-600 hover:bg-gray-100' }}">Toutes</a>
            <a href="{{ path('app_invoice_index', {'status': 'draft'}|merge(activeFilters)) }}" class="px-4 py-1.5 rounded-full text-sm font-medium {{ currentStatus == 'draft' ? 'bg-blue-600 text-white' : 'text-gray-600 hover:bg-gray-100' }}">Brouillons</a>
            <a href="{{ path('app_invoice_index', {'status': 'pending_payment'}|merge(activeFilters)) }}" class="px-4 py-1.5 rounded-full text-sm font-medium {{ currentStatus == 'pending_payment' ? 'bg-blue-600 text-white' : 'text-gray-600 hover:bg-gray-100' }}">En attente</a>
            <a href="{{ path('app_invoice_index', {'status': 'paid'}|merge(activeFilters)) }}" class="px-4 py-1.5 rounded-full text-sm font-medium {{ currentStatus == 'paid' ? 'bg-blue-600 text-white' : 'text-gray-600 hover:bg-gray-100' }}">Payées</a>
        </div>

        <table class="w-full">
            <thead>
                <tr class="border-b border-gray-100">
                    <th class="text-left text-sm font-medium text-gray-500 px-6 py-4">Numéro</th>
                    <th class="text-left text-sm font-medium text-gray-500 px-6 py-4">Date</th>
                    <th class="text-left text-sm font-medium text-gray-500 px-6 py-4">Client</th>
                    <th class="text-left text-sm font-medium text-gray-500 px-6 py-4">Total TTC</th>
                    <th class="text-left text-sm font-medium text-gray-500 px-6 py-4">Statut</th>
                    <th class="text-right text-sm font-medium text-gray-500 px-6 py-4">Actions</th>
                </tr>
            </thead>
            <tbody>
                {% for invoice in invoices %}
                <tr class="border-b border-gray-50 hover:bg-gray-50 transition">
                    <td class="px-6 py-4 text-sm font-medium text-gray-800">{{ invoice.number }}</td>
                    <td class="px-6 py-4 text-sm text-gray-500">{{ invoice.createdAt|date('d/m/Y') }}</td>
                    <td class="px-6 py-4 text-sm text-gray-500">{{ invoice.client ? invoice.client.name : '-' }}</td>
                    <td class="px-6 py-4 text-sm text-gray-800">{{ invoice.totalTtc }} €</td>
                    <td class="px-6 py-4">
                        {% if invoice.status == 'draft' %}
                            <span class="px-2 py-1 rounded-full text-xs font-medium bg-gray-100 text-gray-600">Brouillon</span>
                        {% elseif invoice.status == 'pending_payment' %}
                            <span class="px-2 py-1 rounded-full text-xs font-medium bg-orange-100 text-orange-600">En attente</span>
                        {% else %}
                            <span class="px-2 py-1 rounded-full text-xs font-medium bg-green-100 text-green-600">Payée</span>
                        {% endif %}
                    </td>
                    <td class="px-6 py-4">
                        <div class="flex items-center justify-end gap-3">
                            <a href="{{ path('app_invoice_show', {'id': invoice.id}) }}" class="text-gray-500 hover:text-gray-700 text-sm">Détails</a>
                            <button onclick="document.getElementById('preview-{{ invoice.id }}').classList.remove('hidden')" class="text-gray-400 hover:text-gray-600">
                                <svg xmlns="http://www.w3.org/2000/svg" class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 12a3 3 0 11-6 0 3 3 0 016 0z"/><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M2.458 12C3.732 7.943 7.523 5 12 5c4.478 0 8.268 2.943 9.542 7-1.274 4.057-5.064 7-9.542 7-4.477 0-8.268-2.943-9.542-7z"/></svg>
                            </button>
                            {% if invoice.status == 'draft' %}
                                <a href="{{ path('app_invoice_edit', {'id': invoice.id}) }}" class="text-blue-500 hover:text-blue-700">
                                    <svg xmlns="http://www.w3.org/2000/svg" class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M11 5H6a2 2 0 00-2 2v11a2 2 0 002 2h11a2 2 0 002-2v-5m-1.414-9.414a2 2 0 112.828 2.828L11.828 15H9v-2.828l8.586-8.586z"/></svg>
                                </a>
                                {{ include('invoice/_delete_form.html.twig') }}
                            {% endif %}
                        </div>
                    </td>
                </tr>
                {% else %}
                <tr>
                    <td colspan="6" class="px-6 py-8 text-center text-sm text-gray-400">Aucune facture trouvée</td>
                </tr>
                {% endfor %}
            </tbody>
        </table>

        {% if invoices.haveToPaginate %}
        <div class="flex items-center justify-between px-6 py-4 border-t border-gray-100">
            <p class="text-sm text-gray-500">
                Page {{ invoices.currentPage }} sur {{ invoices.nbPages }}
                ({{ invoices.nbResults }} factures)
            </p>
            <div class="flex gap-2">
                {% if invoices.hasPreviousPage %}
                    <a href="{{ path('app_invoice_index', {'page': invoices.previousPage, 'status': currentStatus}|merge(activeFilters)) }}" class="px-3 py-1.5 text-sm text-gray-600 border border-gray-300 rounded-lg hover:bg-gray-50 transition">
                        ← Précédent
                    </a>
                {% endif %}
                {% for page in range(1, invoices.nbPages) %}
                    <a href="{{ path('app_invoice_index', {'page': page, 'status': currentStatus}|merge(activeFilters)) }}" class="px-3 py-1.5 text-sm rounded-lg transition {{ page == invoices.currentPage ? 'bg-blue-600 text-white' : 'text-gray-600 border border-gray-300 hover:bg-gray-50' }}">
                        {{ page }}
                    </a>
                {% endfor %}
                {% if invoices.hasNextPage %}
                    <a href="{{ path('app_invoice_index', {'page': invoices.nextPage, 'status': currentStatus}|merge(activeFilters)) }}" class="px-3 py-1.5 text-sm text-gray-600 border border-gray-300 rounded-lg hover:bg-gray-50 transition">
                        Suivant →
                    </a>
                {% endif %}
            </div>
        </div>
        {% endif %}
    </div>
</div>

{# Modales de prévisualisation - en dehors du tableau #}
{% for invoice in invoices %}
<div id="preview-{{ invoice.id }}" class="hidden fixed inset-0 z-50 flex items-center justify-center" style="background-color: rgba(0,0,0,0.5);">
    <div class="bg-white rounded-xl shadow-xl w-full max-w-3xl mx-4 max-h-screen overflow-y-auto">
        <div class="flex items-center justify-between p-6 border-b border-gray-100">
            <h2 class="text-lg font-bold text-gray-800">Aperçu — {{ invoice.number }}</h2>
            <button onclick="document.getElementById('preview-{{ invoice.id }}').classList.add('hidden')" class="text-gray-400 hover:text-gray-600">
                <svg xmlns="http://www.w3.org/2000/svg" class="w-6 h-6" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"/></svg>
            </button>
        </div>
        <div class="p-8">
            <div class="flex justify-between mb-8">
                <div>
                    <p class="font-bold text-gray-800 text-lg">{{ invoice.user.companyName }}</p>
                    <p class="text-sm text-gray-500">{{ invoice.user.firstName }} {{ invoice.user.lastName }}</p>
                    <p class="text-sm text-gray-500">{{ invoice.user.email }}</p>
                </div>
                <div class="text-right">
                    <p class="font-bold text-gray-800 text-lg">FACTURE</p>
                    <p class="text-sm text-gray-500">N° {{ invoice.number }}</p>
                    <p class="text-sm text-gray-500">Date : {{ invoice.createdAt|date('d/m/Y') }}</p>
                </div>
            </div>
            {% if invoice.client %}
            <div class="bg-gray-50 rounded-lg p-4 mb-8 w-64 ml-auto">
                <p class="text-xs text-gray-400 uppercase mb-2">Facturé à</p>
                <p class="font-bold text-gray-800">{{ invoice.client.name }}</p>
                <p class="text-sm text-gray-500">{{ invoice.client.address }}</p>
                <p class="text-sm text-gray-500">{{ invoice.client.email }}</p>
            </div>
            {% endif %}
            <table class="w-full mb-6">
                <thead>
                    <tr class="border-b border-gray-200">
                        <th class="text-left text-sm font-medium text-gray-500 py-3">Description</th>
                        <th class="text-center text-sm font-medium text-gray-500 py-3">Qté</th>
                        <th class="text-right text-sm font-medium text-gray-500 py-3">Prix Unitaire</th>
                        <th class="text-right text-sm font-medium text-gray-500 py-3">Total TTC</th>
                    </tr>
                </thead>
                <tbody>
                    {% for product in invoice.products %}
                    <tr class="border-b border-gray-100">
                        <td class="py-3 text-sm text-gray-800">{{ product.name }}</td>
                        <td class="py-3 text-sm text-center text-gray-600">{{ product.quantity }}</td>
                        <td class="py-3 text-sm text-right text-gray-600">{{ product.price }} €</td>
                        <td class="py-3 text-sm text-right font-medium text-gray-800">{{ product.price * product.quantity }} €</td>
                    </tr>
                    {% endfor %}
                </tbody>
            </table>
            <div class="flex justify-end mb-6">
                <div class="w-64">
                    <div class="flex justify-between py-2 border-t border-gray-200">
                        <span class="font-bold text-gray-800">Total TTC</span>
                        <span class="font-bold text-gray-800">{{ invoice.totalTtc }} €</span>
                    </div>
                    <p class="text-xs text-gray-400 text-right mt-1">TVA non applicable, art. 293 B du CGI</p>
                </div>
            </div>
            {% if invoice.client %}
            <div class="border-t border-gray-100 pt-4">
                <p class="text-sm text-gray-500 font-medium">Conditions de paiement</p>
                <div class="bg-gray-50 rounded-lg p-3 mt-2">
                    <p class="text-sm text-gray-500">Coordonnées bancaires :</p>
                    <p class="text-sm text-gray-700 font-medium">{{ invoice.user.iban }}</p>
                </div>
            </div>
            {% endif %}
        </div>
        <div class="flex justify-end gap-3 p-6 border-t border-gray-100">
            <a href="{{ path('app_invoice_show', {'id': invoice.id}) }}" class="px-4 py-2 text-sm text-blue-600 border border-blue-300 rounded-lg hover:bg-blue-50 transition">
                Voir les détails
            </a>
            <button onclick="document.getElementById('preview-{{ invoice.id }}').classList.add('hidden')" class="px-4 py-2 text-sm text-gray-600 border border-gray-300 rounded-lg hover:bg-gray-50 transition">
                Fermer
            </button>
        </div>
    </div>
</div>
{% endfor %}

{% endblock %}
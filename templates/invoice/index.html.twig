{% extends 'base.html.twig' %}

{% block title %}Factures{% endblock %}

{% block body %}
{% set activeFilters = {} %}
{% for key, value in filters %}
    {% if value is not empty %}
        {% set activeFilters = activeFilters|merge({(key): value}) %}
    {% endif %}
{% endfor %}

<div>
    <div class="flex items-center justify-between mb-6">
        <h1 class="text-2xl font-bold text-gray-800">Factures</h1>
        <a href="{{ path('app_invoice_new') }}" class="bg-blue-600 hover:bg-blue-700 text-white text-sm font-semibold px-4 py-2 rounded-lg flex items-center gap-2 transition">
            + Créer une facture
        </a>
    </div>

    {{ include('invoice/_filters.html.twig') }}

    {% if currentStatus %}
        {{ include('invoice/_bulk_actions.html.twig') }}
    {% endif %}

    <div class="bg-white rounded-xl shadow-sm">
        <div class="flex gap-2 p-4 border-b border-gray-100">
            <a href="{{ path('app_invoice_index', activeFilters) }}" class="px-4 py-1.5 rounded-full text-sm font-medium {{ currentStatus is null ? 'bg-blue-600 text-white' : 'text-gray-600 hover:bg-gray-100' }}">Toutes</a>
            <a href="{{ path('app_invoice_index', {'status': 'draft'}|merge(activeFilters)) }}" class="px-4 py-1.5 rounded-full text-sm font-medium {{ currentStatus == 'draft' ? 'bg-blue-600 text-white' : 'text-gray-600 hover:bg-gray-100' }}">Brouillons</a>
            <a href="{{ path('app_invoice_index', {'status': 'pending_payment'}|merge(activeFilters)) }}" class="px-4 py-1.5 rounded-full text-sm font-medium {{ currentStatus == 'pending_payment' ? 'bg-blue-600 text-white' : 'text-gray-600 hover:bg-gray-100' }}">En attente</a>
            <a href="{{ path('app_invoice_index', {'status': 'paid'}|merge(activeFilters)) }}" class="px-4 py-1.5 rounded-full text-sm font-medium {{ currentStatus == 'paid' ? 'bg-blue-600 text-white' : 'text-gray-600 hover:bg-gray-100' }}">Payées</a>
        </div>

        <table class="w-full">
            <thead>
                <tr class="border-b border-gray-100">
                    {% if currentStatus %}
                    <th class="text-left px-6 py-4">
                        <input type="checkbox" id="selectAll" class="rounded" onchange="toggleAll(this)">
                    </th>
                    {% endif %}
                    <th class="text-left text-sm font-medium text-gray-500 px-6 py-4">Numéro</th>
                    <th class="text-left text-sm font-medium text-gray-500 px-6 py-4">Date</th>
                    <th class="text-left text-sm font-medium text-gray-500 px-6 py-4">Client</th>
                    <th class="text-left text-sm font-medium text-gray-500 px-6 py-4">Total TTC</th>
                    <th class="text-left text-sm font-medium text-gray-500 px-6 py-4">Statut</th>
                    <th class="text-right text-sm font-medium text-gray-500 px-6 py-4">Actions</th>
                </tr>
            </thead>
            <tbody>
                {% for invoice in invoices %}
                <tr class="border-b border-gray-50 hover:bg-gray-50 transition">
                    {% if currentStatus %}
                    <td class="px-6 py-4">
                        <input type="checkbox" class="invoice-checkbox rounded" value="{{ invoice.id }}" data-status="{{ invoice.status }}" onchange="updateBulkActions()">
                    </td>
                    {% endif %}
                    <td class="px-6 py-4 text-sm font-medium text-gray-800">{{ invoice.number }}</td>
                    <td class="px-6 py-4 text-sm text-gray-500">{{ invoice.createdAt|date('d/m/Y') }}</td>
                    <td class="px-6 py-4 text-sm text-gray-500">{{ invoice.client ? invoice.client.name : '-' }}</td>
                    <td class="px-6 py-4 text-sm text-gray-800">{{ invoice.totalTtc }} €</td>
                    <td class="px-6 py-4">
                        {% if invoice.status == 'draft' %}
                            <span class="px-2 py-1 rounded-full text-xs font-medium bg-gray-100 text-gray-600">Brouillon</span>
                        {% elseif invoice.status == 'pending_payment' %}
                            <span class="px-2 py-1 rounded-full text-xs font-medium bg-orange-100 text-orange-600">En attente</span>
                        {% else %}
                            <span class="px-2 py-1 rounded-full text-xs font-medium bg-green-100 text-green-600">Payée</span>
                        {% endif %}
                    </td>
                    <td class="px-6 py-4">
                        <div class="flex items-center justify-end gap-3">
                            <a href="{{ path('app_invoice_show', {'id': invoice.id}) }}" class="text-gray-500 hover:text-gray-700 text-sm">Détails</a>
                            <button onclick="document.getElementById('preview-{{ invoice.id }}').classList.remove('hidden')" class="text-gray-400 hover:text-gray-600">
                                <svg xmlns="http://www.w3.org/2000/svg" class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 12a3 3 0 11-6 0 3 3 0 016 0z"/><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M2.458 12C3.732 7.943 7.523 5 12 5c4.478 0 8.268 2.943 9.542 7-1.274 4.057-5.064 7-9.542 7-4.477 0-8.268-2.943-9.542-7z"/></svg>
                            </button>
                            {% if invoice.status == 'draft' %}
                                <a href="{{ path('app_invoice_edit', {'id': invoice.id}) }}" class="text-blue-500 hover:text-blue-700">
                                    <svg xmlns="http://www.w3.org/2000/svg" class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M11 5H6a2 2 0 00-2 2v11a2 2 0 002 2h11a2 2 0 002-2v-5m-1.414-9.414a2 2 0 112.828 2.828L11.828 15H9v-2.828l8.586-8.586z"/></svg>
                                </a>
                                {{ include('invoice/_delete_form.html.twig') }}
                            {% endif %}
                        </div>
                    </td>
                </tr>
                {% else %}
                <tr>
                    <td colspan="{{ currentStatus ? 7 : 6 }}" class="px-6 py-8 text-center text-sm text-gray-400">Aucune facture trouvée</td>
                </tr>
                {% endfor %}
            </tbody>
        </table>

        {% if invoices.haveToPaginate %}
        <div class="flex items-center justify-between px-6 py-4 border-t border-gray-100">
            <p class="text-sm text-gray-500">
                Page {{ invoices.currentPage }} sur {{ invoices.nbPages }}
                ({{ invoices.nbResults }} factures)
            </p>
            <div class="flex gap-2">
                {% if invoices.hasPreviousPage %}
                    <a href="{{ path('app_invoice_index', {'page': invoices.previousPage, 'status': currentStatus}|merge(activeFilters)) }}" class="px-3 py-1.5 text-sm text-gray-600 border border-gray-300 rounded-lg hover:bg-gray-50 transition">← Précédent</a>
                {% endif %}
                {% for page in range(1, invoices.nbPages) %}
                    <a href="{{ path('app_invoice_index', {'page': page, 'status': currentStatus}|merge(activeFilters)) }}" class="px-3 py-1.5 text-sm rounded-lg transition {{ page == invoices.currentPage ? 'bg-blue-600 text-white' : 'text-gray-600 border border-gray-300 hover:bg-gray-50' }}">{{ page }}</a>
                {% endfor %}
                {% if invoices.hasNextPage %}
                    <a href="{{ path('app_invoice_index', {'page': invoices.nextPage, 'status': currentStatus}|merge(activeFilters)) }}" class="px-3 py-1.5 text-sm text-gray-600 border border-gray-300 rounded-lg hover:bg-gray-50 transition">Suivant →</a>
                {% endif %}
            </div>
        </div>
        {% endif %}
    </div>
</div>

{% for invoice in invoices %}
    {{ include('invoice/_preview_modal.html.twig') }}
{% endfor %}

<div id="deleteModal" class="hidden fixed inset-0 flex items-center justify-center z-50" style="background-color: rgba(0,0,0,0.5);">
    <div class="bg-white rounded-xl p-6 w-80 shadow-xl">
        <h3 class="text-lg font-bold text-gray-800 mb-2">Confirmer la suppression</h3>
        <p class="text-sm text-gray-500 mb-6">Êtes-vous sûr de vouloir supprimer cette facture ? Cette action est irréversible.</p>
        <div class="flex gap-3 justify-end">
            <button onclick="closeDeleteModal()" class="px-4 py-2 text-sm text-gray-600 border border-gray-300 rounded-lg hover:bg-gray-50 transition">Annuler</button>
            <button id="confirmDelete" class="px-4 py-2 text-sm bg-red-600 hover:bg-red-700 text-white font-semibold rounded-lg transition">Supprimer</button>
        </div>
    </div>
</div>

<script>
var formToSubmit = null;

function openDeleteModal(btn) {
    formToSubmit = btn.closest('form');
    document.getElementById('deleteModal').classList.remove('hidden');
}

function closeDeleteModal() {
    document.getElementById('deleteModal').classList.add('hidden');
    formToSubmit = null;
}

document.getElementById('confirmDelete').addEventListener('click', function() {
    if (formToSubmit) formToSubmit.submit();
});

{% if currentStatus %}
function updateBulkActions() {
    const checkboxes = document.querySelectorAll('.invoice-checkbox:checked');
    const count = checkboxes.length;
    const bulkActions = document.getElementById('bulkActions');
    const selectedCount = document.getElementById('selectedCount');

    selectedCount.textContent = count;
    bulkActions.classList.toggle('hidden', count === 0);

    const statuses = Array.from(checkboxes).map(cb => cb.dataset.status);
    const noneDraft = statuses.every(s => s !== 'draft');
    const allPending = statuses.every(s => s === 'pending_payment');
    const hasDraft = statuses.some(s => s === 'draft');

    const btnPdf = document.getElementById('btnBulkPdf');
    const btnPay = document.getElementById('btnBulkPay');
    const btnDelete = document.getElementById('btnBulkDelete');

    btnPdf.disabled = !noneDraft;
    btnPdf.type = noneDraft ? 'submit' : 'button';
    btnPay.disabled = !allPending;
    btnPay.type = allPending ? 'submit' : 'button';
    btnDelete.disabled = !hasDraft;
    btnDelete.type = hasDraft ? 'submit' : 'button';

    const ids = Array.from(checkboxes).map(cb => cb.value);
    ['bulkPdfIds', 'bulkPayIds', 'bulkDeleteIds'].forEach(containerId => {
        const container = document.getElementById(containerId);
        container.innerHTML = '';
        ids.forEach(id => {
            const input = document.createElement('input');
            input.type = 'hidden';
            input.name = 'ids[]';
            input.value = id;
            container.appendChild(input);
        });
    });
}

function toggleAll(checkbox) {
    document.querySelectorAll('.invoice-checkbox').forEach(cb => {
        cb.checked = checkbox.checked;
    });
    updateBulkActions();
}
{% endif %}
</script>

{% endblock %}
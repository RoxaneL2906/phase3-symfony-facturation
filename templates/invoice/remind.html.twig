{% extends 'base.html.twig' %}

{% block title %}Relancer le client - {{ invoice.number }}{% endblock %}

{% block body %}
<div class="max-w-2xl mx-auto">
    <div class="flex items-center justify-between mb-6">
        <div>
            <a href="{{ path('app_invoice_show', {'id': invoice.id}) }}" class="text-sm text-gray-500 hover:text-gray-700">← Retour à la facture</a>
            <h1 class="text-2xl font-bold text-gray-800 mt-1">Relancer le client</h1>
            <p class="text-sm text-gray-500 mt-1">Facture {{ invoice.number }} — {{ invoice.client.name }}</p>
        </div>
    </div>

    <div class="bg-white rounded-xl shadow-sm p-8">
        <form method="post" action="{{ path('app_invoice_remind', {'id': invoice.id}) }}">
            <div class="mb-6">
                <label class="block text-sm text-gray-600 mb-1">Message de relance</label>
                <textarea name="message" rows="6" class="w-full border border-gray-300 rounded-lg px-3 py-2 text-sm focus:outline-none focus:ring-2 focus:ring-blue-500">{{ defaultMessage }}</textarea>
            </div>
            <p class="text-xs text-gray-400 mb-6">La facture PDF sera automatiquement jointe à ce mail.</p>
            <div class="flex gap-3 justify-end">
                <a href="{{ path('app_invoice_show', {'id': invoice.id}) }}" class="px-4 py-2 text-sm text-gray-600 border border-gray-300 rounded-lg hover:bg-gray-50 transition">
                    Annuler
                </a>
                <button type="submit" class="px-4 py-2 text-sm bg-blue-600 hover:bg-blue-700 text-white font-semibold rounded-lg transition">
                    Envoyer la relance
                </button>
            </div>
        </form>
    </div>
</div>
{% endblock %}
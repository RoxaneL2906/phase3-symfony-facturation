{% extends 'base.html.twig' %}

{% block title %}Mon Profil{% endblock %}

{% block body %}
<div class="max-w-2xl">
    <h1 class="text-2xl font-bold text-gray-800 mb-6">Mon Profil</h1>

    <div class="bg-white rounded-xl shadow-sm p-8">
        {{ form_start(form) }}

        <div class="mb-4">
            <label class="block text-sm text-gray-600 mb-1">Raison Sociale</label>
            {{ form_widget(form.companyName, {'attr': {'class': 'w-full border border-gray-300 rounded-lg px-3 py-2 text-sm focus:outline-none focus:ring-2 focus:ring-blue-500'}}) }}
            <p class="text-xs text-gray-400 mt-1">Le nom de votre entreprise qui apparaîtra sur vos factures.</p>
            {{ form_errors(form.companyName) }}
        </div>

        <div class="mb-4">
            <label class="block text-sm text-gray-600 mb-1">Numéro SIRET (Optionnel)</label>
            {{ form_widget(form.siret, {'attr': {'class': 'w-full border border-gray-300 rounded-lg px-3 py-2 text-sm focus:outline-none focus:ring-2 focus:ring-blue-500'}}) }}
            {{ form_errors(form.siret) }}
        </div>

        <div class="mb-4">
            <label class="block text-sm text-gray-600 mb-1">IBAN</label>
            {{ form_widget(form.iban, {'attr': {'class': 'w-full border border-gray-300 rounded-lg px-3 py-2 text-sm focus:outline-none focus:ring-2 focus:ring-blue-500'}}) }}
            <p class="text-xs text-gray-400 mt-1">Compte bancaire qui recevra les virements de vos clients.</p>
            {{ form_errors(form.iban) }}
        </div>

        <div class="mb-6">
            <label class="block text-sm text-gray-600 mb-1">Conditions Générales de Vente (CGV)</label>
            <textarea name="cgv" rows="4" placeholder="Ces conditions apparaîtront en bas de vos factures PDF..."
                class="w-full border border-gray-300 rounded-lg px-3 py-2 text-sm focus:outline-none focus:ring-2 focus:ring-blue-500"></textarea>
        </div>

        <button type="submit" class="bg-blue-600 hover:bg-blue-700 text-white font-semibold px-6 py-2 rounded-lg transition">
            Enregistrer les modifications
        </button>

        {{ form_widget(form.firstName, {'attr': {'hidden': 'hidden'}}) }}
        {{ form_widget(form.lastName, {'attr': {'hidden': 'hidden'}}) }}

        {{ form_end(form) }}
    </div>
</div>
{% endblock %}
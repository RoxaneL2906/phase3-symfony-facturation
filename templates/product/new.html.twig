{% extends 'base.html.twig' %}

{% block title %}Nouveau produit{% endblock %}

{% block body %}
<div class="flex justify-center">
    <div class="w-full max-w-2xl">
        <div class="flex items-center justify-between mb-6">
            <h1 class="text-2xl font-bold text-gray-800">Nouveau produit</h1>
            <a href="{{ path('app_product_index') }}" class="text-sm text-gray-500 hover:text-gray-700">← Retour</a>
        </div>
        <div class="bg-white rounded-xl shadow-sm p-8">
            {{ form_start(form) }}

            <div class="mb-4">
                <label class="block text-sm text-gray-600 mb-1">Nom</label>
                {{ form_widget(form.name, {'attr': {'class': 'w-full border border-gray-300 rounded-lg px-3 py-2 text-sm focus:outline-none focus:ring-2 focus:ring-blue-500'}}) }}
                {{ form_errors(form.name) }}
            </div>

            <div class="mb-4">
                <label class="block text-sm text-gray-600 mb-1">Description</label>
                {{ form_widget(form.description, {'attr': {'class': 'w-full border border-gray-300 rounded-lg px-3 py-2 text-sm focus:outline-none focus:ring-2 focus:ring-blue-500', 'rows': 3}}) }}
                {{ form_errors(form.description) }}
            </div>

            <div class="flex gap-4 mb-4">
                <div class="flex-1">
                    <label class="block text-sm text-gray-600 mb-1">Prix unitaire (€)</label>
                    {{ form_widget(form.price, {'attr': {'class': 'w-full border border-gray-300 rounded-lg px-3 py-2 text-sm focus:outline-none focus:ring-2 focus:ring-blue-500'}}) }}
                    {{ form_errors(form.price) }}
                </div>
                <div class="flex-1">
                    <label class="block text-sm text-gray-600 mb-1">Unité</label>
                    {{ form_widget(form.unit, {'attr': {'class': 'w-full border border-gray-300 rounded-lg px-3 py-2 text-sm focus:outline-none focus:ring-2 focus:ring-blue-500'}}) }}
                    {{ form_errors(form.unit) }}
                </div>
            </div>

            <div class="mb-4">
                <label class="block text-sm text-gray-600 mb-1">Quantité</label>
                {{ form_widget(form.quantity, {'attr': {'class': 'w-full border border-gray-300 rounded-lg px-3 py-2 text-sm focus:outline-none focus:ring-2 focus:ring-blue-500'}}) }}
                {{ form_errors(form.quantity) }}
            </div>

            <div class="flex gap-3 justify-end mt-6">
                <a href="{{ path('app_product_index') }}" class="px-4 py-2 text-sm text-gray-600 border border-gray-300 rounded-lg hover:bg-gray-50 transition">
                    Annuler
                </a>
                <button type="submit" class="px-4 py-2 text-sm bg-blue-600 hover:bg-blue-700 text-white font-semibold rounded-lg transition">
                    Enregistrer
                </button>
            </div>

            {{ form_end(form) }}
        </div>
    </div>
</div>
{% endblock %}
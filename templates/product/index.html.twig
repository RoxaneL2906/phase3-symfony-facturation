{% extends 'base.html.twig' %}

{% block title %}Produits & Services{% endblock %}

{% block body %}
<div>
    <div class="flex items-center justify-between mb-6">
        <h1 class="text-2xl font-bold text-gray-800">Produits & Services</h1>
        <a href="{{ path('app_product_new') }}" class="bg-blue-600 hover:bg-blue-700 text-white text-sm font-semibold px-4 py-2 rounded-lg flex items-center gap-2 transition">
            + Ajouter un produit
        </a>
    </div>

    <div class="bg-white rounded-xl shadow-sm">
        <table class="w-full">
            <thead>
                <tr class="border-b border-gray-100">
                    <th class="text-left text-sm font-medium text-gray-500 px-6 py-4">Nom</th>
                    <th class="text-left text-sm font-medium text-gray-500 px-6 py-4">Description</th>
                    <th class="text-left text-sm font-medium text-gray-500 px-6 py-4">Prix unitaire</th>
                    <th class="text-right text-sm font-medium text-gray-500 px-6 py-4">Actions</th>
                </tr>
            </thead>
            <tbody>
                {% for product in products %}
                <tr class="border-b border-gray-50 hover:bg-gray-50 transition">
                    <td class="px-6 py-4 text-sm font-medium text-gray-800">{{ product.name }}</td>
                    <td class="px-6 py-4 text-sm text-gray-500">{{ product.description }}</td>
                    <td class="px-6 py-4 text-sm text-gray-800">{{ product.price }} € / {{ product.unit }}</td>
                    <td class="px-6 py-4">
                        <div class="flex items-center justify-end gap-3">
                            <a href="{{ path('app_product_edit', {'id': product.id}) }}" class="text-blue-500 hover:text-blue-700">
                                <svg xmlns="http://www.w3.org/2000/svg" class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M11 5H6a2 2 0 00-2 2v11a2 2 0 002 2h11a2 2 0 002-2v-5m-1.414-9.414a2 2 0 112.828 2.828L11.828 15H9v-2.828l8.586-8.586z"/></svg>
                            </a>
                            {{ include('product/_delete_form.html.twig') }}
                        </div>
                    </td>
                </tr>
                {% else %}
                <tr>
                    <td colspan="4" class="px-6 py-8 text-center text-sm text-gray-400">Aucun produit trouvé</td>
                </tr>
                {% endfor %}
            </tbody>
        </table>
    </div>
</div>
{% endblock %}